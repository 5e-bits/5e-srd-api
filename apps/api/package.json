{
  "name": "dnd-5e-srd-api",
  "version": "5.12.0",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build:ts": "tsc && tsc-alias",
    "build": "pnpm run clean && pnpm run bundle-swagger && pnpm run build:ts && pnpm run copy-assets",
    "clean": "rm -rf dist",
    "copy-assets": "mkdir -p dist && cp -R src/css dist/src && cp -R src/public dist/src",
    "start": "pnpm run build && node dist/src/start.js",
    "dev": "nodemon pnpm run start",
    "lint": "eslint . --config eslint.config.js",
    "lint:fix": "eslint . --config eslint.config.js --fix",
    "validate-swagger": "redocly lint src/swagger/swagger.yml",
    "bundle-swagger": "pnpm run validate-swagger && redocly bundle --output dist/openapi.yml src/swagger/swagger.yml && redocly bundle --output dist/openapi.json src/swagger/swagger.yml",
    "gen-postman": "pnpm run bundle-swagger && openapi2postmanv2 -s dist/openapi.yml -o dist/collection.postman.json -c openapi-to-postman.json",
    "test": "pnpm run test:unit && pnpm run test:integration:local",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "test:integration:local": "docker compose pull && docker compose build && docker compose run --use-aliases api pnpm run test:integration"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@bugsnag/js": "^8.10.0",
    "@bugsnag/plugin-express": "^8.8.0",
    "@typegoose/typegoose": "^13.4.0",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "graphql": "^16.14.1",
    "graphql-depth-limit": "^1.1.0",
    "mongoose": "^9.7.4",
    "morgan": "^1.12.1",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "^2.0.0-rc.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@redocly/cli": "^2.53.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/graphql-depth-limit": "^1.1.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "fishery": "^2.3.1",
    "globals": "^17.12.0",
    "mongodb-memory-server": "^11.2.0",
    "node-mocks-http": "^1.18.1",
    "nodemon": "^3.1.10",
    "openapi-to-postmanv2": "^6.3.3",
    "prettier": "^3.9.7",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
