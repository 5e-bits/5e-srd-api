{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "esModuleInterop": true,
    // TypeScript 7 removed `baseUrl`, which @docusaurus/tsconfig 3.10.2 still sets.
    // Unset it, and redeclare `paths` so `@site` resolves from this directory.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    }
  },
  // Compiled bundles, which `allowJs` would otherwise typecheck after a build.
  "exclude": ["build", ".docusaurus", "node_modules"]
}
